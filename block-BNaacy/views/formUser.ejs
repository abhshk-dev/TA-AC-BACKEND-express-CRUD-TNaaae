<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <form action="/users" method="POST">
      <input type="text" name="name" placeholder="enter your name" required />
      <input type="email" name="email" placeholder="enter your email" required />
      <input type="number" name="age" placeholder="enter your Age" />
      <textarea name="address" rows="10" cols="30" maxlength="200" placeholder="enter your address"></textarea>
      <textarea name="bio" rows="10" cols="30" maxlength="200" placeholder="enter your bio"></textarea>
      <textarea name="hobbies" rows="10" cols="20" placeholder="enter your hobbies"></textarea>
      <input type="submit" value="Add user" />
    </form>
  </body>
</html>